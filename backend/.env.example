# 将本文件复制为 backend/.env 并填写自己的值；不要提交实际密钥。
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/job_search_ai?charset=utf8mb4
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false

# 岗位要求提取、证据报告和聊天共用同一模型服务、同一个 API Key。
# BASE_URL 是接口基地址（DeepSeek 无需附加 /v1），MODEL 是模型名称；只有 API_KEY 是密钥。
# 服务需兼容 Chat Completions，且报告步骤需支持 JSON response_format。
JOB_AI_BASE_URL=https://api.deepseek.com
JOB_AI_MODEL=deepseek-flash
JOB_AI_API_KEY=
